{
  "manifest_version": 3,
  "name": "Teams Availability Scheduler",
  "version": "1.0.0",
  "description": "Schedule and maintain your Microsoft Teams availability status",
  "permissions": ["alarms", "tabs", "scripting", "storage", "offscreen"],
  "host_permissions": [
    "https://*.teams.microsoft.com/*",
    "https://*.teams.microsoft.com.mcas.ms/*",
    "https://*.teams.microsoft.us/*",
    "https://*.teams.microsoft.us.mcas.ms/*",
    "https://teams.cloud.microsoft/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/js/keepAlive.js"],
      "matches": [
        "https://*.teams.microsoft.com/*",
        "https://*.teams.microsoft.com.mcas.ms/*",
        "https://*.teams.microsoft.us/*",
        "https://*.teams.microsoft.us.mcas.ms/*",
        "https://teams.cloud.microsoft/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/html/popup.html",
    "default_icon": {
      "16": "src/images/icon16.png",
      "48": "src/images/icon48.png",
      "128": "src/images/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.teams.microsoft.com/*",
        "https://*.teams.microsoft.com.mcas.ms/*",
        "https://*.teams.microsoft.us/*",
        "https://*.teams.microsoft.us.mcas.ms/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": ["src/js/keepAlive.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/images/icon16.png",
    "48": "src/images/icon48.png",
    "128": "src/images/icon128.png"
  }
}